@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string activeTab = "stages";
    private bool isLoadingPending = false;
    private int pendingCount => CloudSync.PendingQueue.Count;

    protected override void OnInitialized()
    {
        CloudSync.OnSyncStateChanged += HandleSyncStateChanged;
    }

    private void HandleSyncStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await RefreshPendingQueue();
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "pending")
        {
            _ = RefreshPendingQueue();
        }
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task TriggerManualSync()
    {
        _ = CloudSync.SyncNowAsync();
        await Task.Yield();
    }

    private void CancelSync()
    {
        CloudSync.CancelSync();
    }

    private void SkipCurrentStep()
    {
        CloudSync.SkipCurrentStage();
    }

    private async Task RefreshPendingQueue()
    {
        isLoadingPending = true;
        StateHasChanged();
        try
        {
            await CloudSync.FetchPendingQueueAsync();
        }
        catch { }
        finally
        {
            isLoadingPending = false;
            StateHasChanged();
        }
    }

    private async Task DismissItem(PendingSyncItemView item)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد بالتأكيد إلغاء واستبعاد {item.Title} من المزامنة نهائياً؟");
        if (confirmed)
        {
            await CloudSync.DismissPendingItemAsync(item.EntityType, item.Id);
            await RefreshPendingQueue();
        }
    }

    private async Task SyncOneItem(PendingSyncItemView item)
    {
        await CloudSync.SyncSinglePendingItemAsync(item.EntityType, item.Id);
        await RefreshPendingQueue();
    }

    private async Task ForceFullCatalogSync()
    {
        _ = CloudSync.SyncNowAsync(forceCatalogPush: true);
        await Task.Yield();
    }

    private string GetStageClass(SyncStageStatus status) => status switch
    {
        SyncStageStatus.InProgress => "in-progress",
        SyncStageStatus.Completed => "completed",
        SyncStageStatus.Failed => "failed",
        _ => ""
    };

    private string GetStatusBadgeClass(SyncStageStatus status) => status switch
    {
        SyncStageStatus.Completed => "badge-completed",
        SyncStageStatus.InProgress => "badge-progress",
        SyncStageStatus.Skipped => "badge-skipped",
        SyncStageStatus.Failed => "badge-failed",
        _ => "badge-pending"
    };

    private string GetStatusText(SyncStageStatus status) => status switch
    {
        SyncStageStatus.Completed => "مكتمل",
        SyncStageStatus.InProgress => "جاري التنفيذ...",
        SyncStageStatus.Skipped => "تم التخطي",
        SyncStageStatus.Failed => "تعذر",
        _ => "في الانتظار"
    };

    private string GetEntityTagClass(string type) => type?.ToLower() switch
    {
        "purchase" => "tag-purchase",
        "sale" => "tag-sale",
        "debtpayment" => "tag-debt",
        "debt" => "tag-debt",
        "expense" => "tag-expense",
        "product" => "tag-product",
        _ => "tag-purchase"
    };

    private string GetEntityTypeName(string type) => type?.ToLower() switch
    {
        "purchase" => "مشتريات موبايل",
        "sale" => "مبيعات صالة (POS)",
        "debtpayment" => "سداد دين عميل",
        "debt" => "سداد دين",
        "expense" => "مصروف تشغيل",
        "product" => "منتج جديد",
        _ => "عنصر معلق"
    };

    public void Dispose()
    {
        CloudSync.OnSyncStateChanged -= HandleSyncStateChanged;
    }
}
