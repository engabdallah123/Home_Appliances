@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using global::POS.Desktop.Pages
@inject CustomAuthStateProvider AuthState
@inject ShiftStateContainer ShiftState
@inject CalculatorStateContainer CalcState
@inject StoreStateContainer StoreState
@inject PosApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject global::POS.Desktop.Services.Sync.ICloudSyncService CloudSync

<div class="app-container">
    @if (openMenu != null)
    {
        <div class="top-nav-backdrop" @onclick="CloseAllMenus"></div>
    }

    <header class="top-nav-bar">
        <!-- RIGHT SIDE (RTL): Brand, Logged-in User Profile (Click opens card with Theme & Logout), Cloud Sync -->
        <div class="nav-section-right">
            <!-- Brand -->
            <a href="" class="nav-brand" title="الرئيسية [Alt + H]" @onclick="CloseAllMenus">
                <div class="nav-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div class="nav-brand-text">
                    <span class="nav-brand-title">@(string.IsNullOrWhiteSpace(StoreState.StoreName) ? "نظام الكاشير" : StoreState.StoreName)</span>
                </div>
            </a>

            @{
                bool isOffline = CloudSync.IsOffline;
                bool isSyncing = CloudSync.IsSyncing && !isOffline;
                bool isFailed = !isSyncing && !isOffline && (CloudSync.LastSyncSucceeded == false || !CloudSync.IsCloudReachable);

                string syncColor = isOffline ? "#94a3b8" : (isSyncing ? "var(--accent-amber)" : (isFailed ? "var(--accent-red)" : "var(--accent-emerald)"));
                string syncBg = isOffline ? "rgba(148, 163, 184, 0.1)" : (isSyncing ? "rgba(251, 191, 36, 0.1)" : (isFailed ? "rgba(248, 113, 113, 0.1)" : "rgba(16, 185, 129, 0.1)"));
                string syncBorder = isOffline ? "rgba(148, 163, 184, 0.25)" : (isSyncing ? "rgba(251, 191, 36, 0.3)" : (isFailed ? "rgba(248, 113, 113, 0.3)" : "rgba(16, 185, 129, 0.3)"));
                string syncIcon = isOffline ? "fa-solid fa-cloud-slash" : (isSyncing ? "fa-solid fa-cloud-arrow-up fa-bounce" : (isFailed ? "fa-solid fa-cloud-xmark" : "fa-solid fa-cloud"));
                string syncLabel = isOffline ? "غير متصل بالسحابة" : (isSyncing ? "جاري المزامنة..." : (isFailed ? "تعذر المزامنة السحابية" : "السحابة متزامنة"));
                string syncTooltip = isOffline ? "الكمبيوتر غير متصل بالإنترنت" : (isSyncing ? "جاري مزامنة البيانات مع السحابة والموبايل..." : (CloudSync.LastSyncStatus ?? "السحابة متزامنة مع السيرفر"));
            }

            <!-- Direct Header Sync Pill Button -->
            <button type="button" 
                    class="header-sync-pill-btn @(isSyncing ? "syncing" : "") @(isFailed ? "failed" : "") @(isOffline ? "offline" : "")"
                    @onclick="HandleSyncClick"
                    title="@(isSyncing ? "جاري المزامنة الآن - اضغط لعرض مراحل المزامنة والمعلقات وإمكانية الإلغاء" : (isOffline ? "غير متصل بالسحابة" : "السحابة متزامنة - اضغط للمزامنة الفورية"))">
                <span class="sync-dot-pulse" style="background-color: @syncColor;"></span>
                <i class="@syncIcon sync-pill-icon" style="color: @syncColor;"></i>
                <span class="sync-pill-text" style="color: @(isSyncing ? "var(--accent-amber)" : (isFailed ? "var(--accent-red)" : (isOffline ? "#94a3b8" : "var(--accent-emerald)")));">
                    @(isSyncing ? $"مزامنة ({CloudSync.CurrentProgressPercent}%)" : (isFailed ? "خطأ مزامنة" : (isOffline ? "أوفلاين" : "متزامن")))
                </span>
                @if (CloudSync.PendingQueue.Count > 0)
                {
                    <span class="sync-pending-chip" title="@($"{CloudSync.PendingQueue.Count} عمليات معلقة في الانتظار")">
                        @CloudSync.PendingQueue.Count
                    </span>
                }
            </button>

            <!-- User Profile Dropdown Trigger (Click opens card with Sync, Theme & Logout) -->
            <div class="dropdown-wrapper">
                <button type="button" class="user-profile-btn @(openMenu == "user" ? "active" : "")" @onclick='() => ToggleMenu("user")' title="خيارات المستخدم، المزامنة، الثيم وتسجيل الخروج">
                    <div class="user-avatar-wrap">
                        <div class="user-avatar">
                            @((AuthState.UserFullName ?? "م")[0])
                        </div>
                        <span class="user-sync-dot" style="background-color: @syncColor;" title="@syncLabel"></span>
                    </div>
                    <div class="user-info-text">
                        <span class="user-name">@(AuthState.UserFullName ?? "مستخدم الكاشير")</span>
                        <span class="user-role">@(IsAdminOrManager ? "مدير النظام" : "كاشير")</span>
                    </div>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>

                @if (openMenu == "user")
                {
                    <div class="top-nav-dropdown-menu user-popover-card">
                        <div class="user-card-header">
                            <div class="user-avatar-lg">
                                @((AuthState.UserFullName ?? "م")[0])
                            </div>
                            <div class="user-card-details">
                                <strong style="color: var(--text-primary); font-size: 0.95rem;">@(AuthState.UserFullName ?? "مستخدم الكاشير")</strong>
                                <span class="badge-role">@(IsAdminOrManager ? "مدير النظام" : "كاشير")</span>
                            </div>
                        </div>

                        <div class="user-card-divider"></div>

                        <!-- 1. Cloud Sync Status & Action Inside User Options -->
                        <button type="button" class="user-sync-menu-btn" @onclick="HandleSyncClick" title="@syncTooltip">
                            <div class="user-sync-icon" style="color: @syncColor; background: @syncBg; border: 1px solid @syncBorder;">
                                <i class="@syncIcon"></i>
                            </div>
                            <div class="user-sync-details">
                                <span class="user-sync-title" style="color: @syncColor;">
                                    @(isSyncing ? $"جاري المزامنة ({CloudSync.CurrentProgressPercent}%)" : syncLabel)
                                </span>
                                <span class="user-sync-sub">@(isOffline ? "غير متصل بالإنترنت" : (isSyncing ? "اضغط لعرض العمليات الحية والمعلقات والإلغاء" : "اضغط للمزامنة الفورية مع السيرفر"))</span>
                            </div>
                            @if (CloudSync.PendingQueue.Count > 0)
                            {
                                <span class="user-sync-badge-pill">@CloudSync.PendingQueue.Count معلق</span>
                            }
                        </button>

                        <button type="button" class="dropdown-item-btn" @onclick="OpenSyncMonitor">
                            <i class="fa-solid fa-list-check" style="color: var(--accent-cyan);"></i>
                            <span>مركز المراقبة والمعلقات السحابية</span>
                        </button>

                        <div class="user-card-divider"></div>

                        <!-- 2. Theme Toggle -->
                        <button type="button" class="dropdown-item-btn" @onclick="ToggleTheme">
                            <i class="fa-solid @(isDarkMode ? "fa-sun" : "fa-moon")" style="color: @(isDarkMode ? "var(--accent-amber)" : "var(--accent-indigo)");"></i>
                            <span>تبديل المظهر إلى @(isDarkMode ? "الفاتح" : "الداكن")</span>
                        </button>

                        <div class="user-card-divider"></div>

                        <!-- 3. Logout -->
                        <button type="button" class="dropdown-item-btn text-danger" @onclick="Logout">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>تسجيل الخروج من الحساب</span>
                        </button>
                    </div>
                }
            </div>

            <!-- POS البيع (على اليمين بجانب المستخدم والبراند) -->
            <NavLink href="pos" class="top-nav-link pos-highlight-link" @onclick="CloseAllMenus" title="شاشة البيع (POS) [Alt + P]">
                <i class="fa-solid fa-cash-register text-emerald"></i>
                <span>شاشة البيع (POS)</span>
            </NavLink>
        </div>

        <!-- LEFT SIDE (RTL): All Navigation Categories + Tools shifted to the left -->
        <nav class="nav-section-left">
            <!-- 1. الرئيسية -->
            <NavLink href="" class="top-nav-link" Match="NavLinkMatch.All" @onclick="CloseAllMenus" title="الرئيسية [Alt + H]">
                <i class="fa-solid fa-house text-indigo"></i>
                <span>الرئيسية</span>
            </NavLink>

            <!-- 2. المبيعات والديون ▾ -->
            <div class="dropdown-wrapper">
                <button type="button" class="top-nav-dropdown-trigger @(openMenu == "sales" ? "open" : "")" @onclick='() => ToggleMenu("sales")'>
                    <i class="fa-solid fa-receipt text-blue"></i>
                    <span>المبيعات والديون</span>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>
                @if (openMenu == "sales")
                {
                    <div class="top-nav-dropdown-menu">
                        <NavLink class="dropdown-item" href="sales" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-list-check text-blue"></i>
                            <div class="item-text">
                                <span class="item-title">سجل المبيعات</span>
                                <span class="item-desc">فواتير البيع وأرشيف الكاشير</span>
                            </div>
                        </NavLink>
                        @if (IsAdminOrManager)
                        {
                            <NavLink class="dropdown-item" href="monthly-report" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-calendar-days text-amber"></i>
                                <div class="item-text">
                                    <span class="item-title">نتيجة المبيعات الشهرية</span>
                                    <span class="item-desc">الأرباح اليومية والتقويم المالي</span>
                                </div>
                            </NavLink>
                        }
                        <NavLink class="dropdown-item" href="debts" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-hand-holding-dollar text-cyan"></i>
                            <div class="item-text">
                                <span class="item-title">فواتير الديون والتحصيل</span>
                                <span class="item-desc">أرصدة العملاء وسندات القبض</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="installments" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-file-invoice-dollar text-emerald"></i>
                            <div class="item-text">
                                <span class="item-title">عقود وأقساط الأجهزة</span>
                                <span class="item-desc">جدولة وتحصيل الأقساط الشهرية</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="reservations" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-box-archive text-pink"></i>
                            <div class="item-text">
                                <span class="item-title">حجوزات جهاز العروسة</span>
                                <span class="item-desc">أجهزة مؤجلة مع العربون والتسليم</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="offers" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-gift text-purple"></i>
                            <div class="item-text">
                                <span class="item-title">العروض وبكجات التخفيض</span>
                                <span class="item-desc">عروض العرائس وحزم الأجهزة</span>
                            </div>
                        </NavLink>
                    </div>
                }
            </div>

            <!-- 4. المشتريات والمخزن ▾ -->
            <div class="dropdown-wrapper">
                <button type="button" class="top-nav-dropdown-trigger @(openMenu == "inventory" ? "open" : "")" @onclick='() => ToggleMenu("inventory")'>
                    <i class="fa-solid fa-boxes-stacked text-amber"></i>
                    <span>المشتريات والمخزن</span>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>
                @if (openMenu == "inventory")
                {
                    <div class="top-nav-dropdown-menu">
                        <NavLink class="dropdown-item" href="products" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-box text-blue"></i>
                            <div class="item-text">
                                <span class="item-title">المنتجات والمخزون</span>
                                <span class="item-desc">كتالوج الأجهزة والباركود والكميات</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="brands" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-award text-cyan"></i>
                            <div class="item-text">
                                <span class="item-title">الماركات التجارية</span>
                                <span class="item-desc">توكيلات الأجهزة (LG، شارب..)</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="categories" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-tags text-amber"></i>
                            <div class="item-text">
                                <span class="item-title">تصنيفات الأجهزة</span>
                                <span class="item-desc">أقسام المعرض والأصناف</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="purchases" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-truck-ramp-box text-emerald"></i>
                            <div class="item-text">
                                <span class="item-title">فواتير المشتريات</span>
                                <span class="item-desc">شحنات الواردات وحسابات الموردين</span>
                            </div>
                        </NavLink>
                    </div>
                }
            </div>

            <!-- 5. إدارة المرتجعات ▾ -->
            <div class="dropdown-wrapper">
                <button type="button" class="top-nav-dropdown-trigger @(openMenu == "returns" ? "open" : "")" @onclick='() => ToggleMenu("returns")'>
                    <i class="fa-solid fa-arrow-right-arrow-left text-purple"></i>
                    <span>المرتجعات</span>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>
                @if (openMenu == "returns")
                {
                    <div class="top-nav-dropdown-menu">
                        <NavLink class="dropdown-item" href="returns/sales" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-rotate-left text-red"></i>
                            <div class="item-text">
                                <span class="item-title">مرتجع مبيعات العملاء</span>
                                <span class="item-desc">إرجاع جهاز واسترداد الفاتورة</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="returns/purchases" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-truck-arrow-right text-amber"></i>
                            <div class="item-text">
                                <span class="item-title">مرتجع مشتريات الموردين</span>
                                <span class="item-desc">إرجاع أجهزة تالفة للموردين</span>
                            </div>
                        </NavLink>
                    </div>
                }
            </div>

            <!-- 6. المالية والورديات ▾ -->
            <div class="dropdown-wrapper">
                <button type="button" class="top-nav-dropdown-trigger @(openMenu == "finance" ? "open" : "")" @onclick='() => ToggleMenu("finance")'>
                    <i class="fa-solid fa-wallet text-indigo"></i>
                    <span>المالية والورديات</span>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>
                @if (openMenu == "finance")
                {
                    <div class="top-nav-dropdown-menu">
                        <NavLink class="dropdown-item" href="shifts" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-clock-rotate-left text-blue"></i>
                            <div class="item-text">
                                <span class="item-title">الورديات والخزينة</span>
                                <span class="item-desc">فتح وإغلاق اليومية والدرج</span>
                            </div>
                        </NavLink>
                        <NavLink class="dropdown-item" href="expenses" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-file-invoice-dollar text-red"></i>
                            <div class="item-text">
                                <span class="item-title">المصروفات العامة</span>
                                <span class="item-desc">فواتير الكهرباء والإيجار والعمالة</span>
                            </div>
                        </NavLink>
                    </div>
                }
            </div>

            <!-- 7. الإدارة والتحكم ▾ (Admin/Manager) -->
            @if (IsAdminOrManager)
            {
                <div class="dropdown-wrapper">
                    <button type="button" class="top-nav-dropdown-trigger @(openMenu == "admin" ? "open" : "")" @onclick='() => ToggleMenu("admin")'>
                        <i class="fa-solid fa-sliders text-cyan"></i>
                        <span>الإدارة والتحكم</span>
                        <i class="fa-solid fa-chevron-down nav-arrow"></i>
                    </button>
                    @if (openMenu == "admin")
                    {
                        <div class="top-nav-dropdown-menu">
                            <NavLink class="dropdown-item" href="dashboard" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-chart-line text-blue"></i>
                                <div class="item-text">
                                    <span class="item-title">لوحة التحكم</span>
                                    <span class="item-desc">مؤشرات الأداء وتحليلات المعرض</span>
                                </div>
                            </NavLink>
                            <NavLink class="dropdown-item" href="users" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-users text-cyan"></i>
                                <div class="item-text">
                                    <span class="item-title">المستخدمين والصلاحيات</span>
                                    <span class="item-desc">إدارة الكاشيرين والمديرين</span>
                                </div>
                            </NavLink>
                            <NavLink class="dropdown-item" href="backup" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-shield-halved text-emerald"></i>
                                <div class="item-text">
                                    <span class="item-title">النسخ الاحتياطي</span>
                                    <span class="item-desc">أخذ واستعادة قاعدة البيانات</span>
                                </div>
                            </NavLink>
                            <NavLink class="dropdown-item" href="settings" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-gear text-amber"></i>
                                <div class="item-text">
                                    <span class="item-title">الإعدادات</span>
                                    <span class="item-desc">الطباعة، الضريبة، ومعلومات المحل</span>
                                </div>
                            </NavLink>
                            <NavLink class="dropdown-item" href="audit" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-fingerprint text-purple"></i>
                                <div class="item-text">
                                    <span class="item-title">سجل الأحداث والرقابة</span>
                                    <span class="item-desc">تتبع كافة حركات وتعديلات النظام</span>
                                </div>
                            </NavLink>
                            <NavLink class="dropdown-item" href="activation" @onclick="CloseAllMenus">
                                <i class="fa-solid fa-key text-yellow"></i>
                                <div class="item-text">
                                    <span class="item-title">ترخيص البرنامج</span>
                                    <span class="item-desc">بيانات المفتاح ومدة التفعيل</span>
                                </div>
                            </NavLink>
                        </div>
                    }
                </div>
            }

            <!-- 7. أدوات ▾ (بجوار الإدارة والتحكم مباشرة بدون أي مسافة فاصلة) -->
            <div class="dropdown-wrapper">
                <button type="button" class="top-nav-dropdown-trigger @(openMenu == "tools" ? "open" : "")" @onclick='() => ToggleMenu("tools")' title="أدوات سريعة ومساعدة">
                    <i class="fa-solid fa-toolbox text-orange"></i>
                    <span>أدوات</span>
                    <i class="fa-solid fa-chevron-down nav-arrow"></i>
                </button>
                @if (openMenu == "tools")
                {
                    <div class="top-nav-dropdown-menu tools-menu">
                        <!-- Price Check -->
                        <NavLink class="dropdown-item" href="price-check" @onclick="CloseAllMenus">
                            <i class="fa-solid fa-tag text-cyan"></i>
                            <div class="item-text">
                                <span class="item-title">الاستعلام عن السعر [Alt+B]</span>
                                <span class="item-desc">استعلام فوري عن سعر ومواصفات الأجهزة</span>
                            </div>
                        </NavLink>
                        <!-- Calculator -->
                        <button type="button" class="dropdown-item" @onclick='() => { CloseAllMenus(); CalcState.Toggle(); }'>
                            <i class="fa-solid fa-calculator text-emerald"></i>
                            <div class="item-text">
                                <span class="item-title">الآلة الحاسبة الذكية [F10 / Alt+C]</span>
                                <span class="item-desc">حاسبة سريعة مع حساب الباقي والنسب</span>
                            </div>
                        </button>
                        <!-- Support Modal -->
                        <button type="button" class="dropdown-item" @onclick='() => { CloseAllMenus(); showSupportModal = true; }'>
                            <i class="fa-solid fa-headset text-indigo"></i>
                            <div class="item-text">
                                <span class="item-title">الدعم الفني والخدمات</span>
                                <span class="item-desc">تواصل مباشر مع فريق الدعم والصيانة</span>
                            </div>
                        </button>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="page-body">
        @Body
    </main>
</div>

<!-- Standalone Global Smart Calculator Modal Window -->
<CalculatorModal />

<!-- 3A Tech Customer Care & Direct Support Modal -->
<SupportModal IsVisible="@showSupportModal" OnClose="() => showSupportModal = false" />

<!-- Cloud Sync Monitor & Control Modal -->
<SyncMonitorModal IsVisible="@showSyncMonitorModal" OnClose="() => showSyncMonitorModal = false" />

@code {
    private bool isDarkMode = true;
    private bool showSupportModal = false;
    private bool showSyncMonitorModal = false;
    private string? openMenu;

    private bool IsAdminOrManager =>
        string.Equals(AuthState.UserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Administrator", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu(string menu)
    {
        if (openMenu == menu)
            openMenu = null;
        else
            openMenu = menu;
    }

    private void CloseAllMenus()
    {
        openMenu = null;
    }

    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getAppTheme");
                isDarkMode = theme != "light";
                await JS.InvokeVoidAsync("setAppTheme", isDarkMode ? "dark" : "light");

                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initGlobalNavigationShortcuts", _dotNetRef);

                if (!StoreState.IsLoaded)
                {
                    await StoreState.LoadSettingsAsync(ApiClient, JS);
                }

                StateHasChanged();
            }
            catch
            {
                // Fallback if JS call fails during startup
            }
        }
    }

    [JSInvokable]
    public void OpenQuickWindow(string route)
    {
        CloseAllMenus();
        Nav.NavigateTo(route);
        if (route == "price-check")
        {
            _ = JS.InvokeVoidAsync("focusElementById", "price-check-name-input", 120);
        }
        else if (route == "products")
        {
            _ = JS.InvokeVoidAsync("focusElementById", "product-quick-scan-barcode", 120);
        }
        else if (route == "purchases")
        {
            _ = JS.InvokeVoidAsync("focusElementById", "purchase-barcode-input", 120);
        }
        else if (route == "pos" || route == "home" || string.IsNullOrEmpty(route))
        {
            _ = JS.InvokeVoidAsync("focusElementById", "pos-barcode-input", 100);
        }
    }

    [JSInvokable]
    public void ToggleCalculatorModal()
    {
        CloseAllMenus();
        CalcState.Toggle();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnGlobalEscPressed()
    {
        if (showSyncMonitorModal)
        {
            showSyncMonitorModal = false;
            StateHasChanged();
            return;
        }

        if (openMenu != null)
        {
            CloseAllMenus();
            StateHasChanged();
            return;
        }

        if (CalcState.IsOpen)
        {
            CalcState.Close();
            StateHasChanged();
            _ = JS.InvokeVoidAsync("focusElementById", "pos-barcode-input", 50);
        }
    }

    protected override void OnInitialized()
    {
        ShiftState.OnShiftStateChanged += StateHasChanged;
        CalcState.OnStateChanged += StateHasChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
        CloudSync.OnSyncStateChanged += StateHasChanged;
        StoreState.OnStateChanged += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CloseAllMenus();
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleSyncClick()
    {
        if (CloudSync.IsSyncing)
        {
            CloseAllMenus();
            showSyncMonitorModal = true;
        }
        else
        {
            CloseAllMenus();
            _ = CloudSync.SyncNowAsync();
        }
        StateHasChanged();
    }

    private void OpenSyncMonitor()
    {
        CloseAllMenus();
        showSyncMonitorModal = true;
    }

    private async Task TriggerHeaderSync()
    {
        await HandleSyncClick();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        var themeStr = isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("setAppTheme", themeStr);
        CloseAllMenus();
    }

    private void Logout()
    {
        CloseAllMenus();
        AuthState.MarkUserAsLoggedOut();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        ShiftState.OnShiftStateChanged -= StateHasChanged;
        CalcState.OnStateChanged -= StateHasChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        CloudSync.OnSyncStateChanged -= StateHasChanged;
        StoreState.OnStateChanged -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
