    private async Task HandleBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!string.IsNullOrWhiteSpace(scannedBarcode))
            {
                var code = scannedBarcode.Trim();
                scannedBarcode = string.Empty;

                // Standard product barcode lookup
                var prod = await ApiClient.GetProductByBarcodeAsync(code);
                if (prod is not null)
                {
                    if (!prod.IsActive)
                    {
                        saleError = $"المنتج '{prod.NameAr}' غير نشط وموقوف عن البيع.";
                    }
                    else
                    {
                        AddToCart(prod);
                    }
                }
                else
                {
                    saleError = $"المنتج بالباركود '{code}' غير موجود.";
                }
                await FocusBarcodeAsync();
            }
            else
            {
                // Barcode is empty and user hit Enter -> Open payment checkout modal if cart has items!
                if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
                {
                    OpenPaymentModal();
                }
            }
        }
    }

    private void AddToCart(ProductDto prod, string initialUnit = "Piece", bool initialWholesale = false)
    {
        if (!prod.IsActive)
        {
            saleError = $"المنتج '{prod.NameAr}' غير نشط وموقوف عن البيع.";
            return;
        }

        saleError = null;
        var existingInCart = Cart.Items.FirstOrDefault(i => i.ProductId == prod.Id);
        var nextQty = (existingInCart?.Quantity ?? 0) + 1;
        CheckAndTriggerStockAlert(prod, nextQty);
        var pkg = PackagingUnitHelper.Parse(prod.Description);
        int conversionFactor = prod.ConversionFactor > 1 
            ? prod.ConversionFactor 
            : (pkg.TotalPiecesPerCarton > 1 ? pkg.TotalPiecesPerCarton : 1);
        int ppb = pkg.PiecesPerBox;
        int bpc = conversionFactor > 1 ? conversionFactor : pkg.BoxesPerCarton;

        Cart.AddOrIncrementProduct(
            prod.Id, 
            prod.Barcode, 
            prod.NameAr, 
            prod.SellingPrice, 
            prod.WholesalePrice, 
            prod.TaxRate, 
            ppb, 
            bpc,
            conversionFactor,
            prod.BaseUnit,
            prod.ParentUnit ?? "قطعة",
            initialUnit,
            initialWholesale,
            false,
            prod.ModelNumber,
            prod.BrandName,
            prod.WarrantyPeriodMonths,
            prod.HasSerialNumber,
            null,
            prod.BrandId,
            prod.CategoryId,
            prod.CategoryName);

        _ = FocusBarcodeAsync();
    }

    private void AddCartonToCart(ProductDto prod)
