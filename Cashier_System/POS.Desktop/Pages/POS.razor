    private void ApplyOfferToCart(OfferDto offer)
    {
        bool isBundle = offer.OfferType == "BundlePackage" || offer.Type == 3 || (offer.Items != null && offer.Items.Any());
        bool isBrand = offer.OfferType == "BrandDiscount" || offer.Type == 2 || offer.TargetBrandId.HasValue;
        bool isCategory = offer.OfferType == "CategoryDiscount" || offer.Type == 1 || offer.TargetCategoryId.HasValue;
        bool isProduct = offer.OfferType == "ProductDiscount" || offer.Type == 0 || offer.TargetProductId.HasValue;

        // 1. Bundle Package
        if (isBundle)
        {
            if (offer.Items != null && offer.Items.Any())
            {
                foreach (var itm in offer.Items)
                {
                    var prod = products.FirstOrDefault(p => p.Id == itm.ProductId);
                    if (prod != null)
                    {
                        var pkg = PackagingUnitHelper.Parse(prod.Description);
                        int conversionFactor = prod.ConversionFactor > 1 
                            ? prod.ConversionFactor 
                            : (pkg.TotalPiecesPerCarton > 1 ? pkg.TotalPiecesPerCarton : 1);
                        
                        decimal priceToUse = prod.SellingPrice;

                        for (int q = 0; q < itm.Quantity; q++)
                        {
                            Cart.AddOrIncrementProduct(
                                prod.Id,
                                prod.Barcode,
                                prod.NameAr,
                                priceToUse,
                                prod.WholesalePrice,
                                prod.TaxRate,
                                pkg.PiecesPerBox,
                                conversionFactor,
                                conversionFactor,
                                prod.BaseUnit,
                                prod.ParentUnit ?? "قطعة",
                                "Piece",
                                false,
                                false,
                                prod.ModelNumber,
                                prod.BrandName,
                                prod.WarrantyPeriodMonths,
                                prod.HasSerialNumber,
                                null,
                                prod.BrandId,
                                prod.CategoryId,
                                prod.CategoryName);
                        }
                    }
                }
            }

            if (offer.PackagePrice > 0)
            {
                var subTotalAfterAdd = Cart.SubTotal;
                if (subTotalAfterAdd > offer.PackagePrice)
                {
                    Cart.OverallDiscount = Math.Round(subTotalAfterAdd - offer.PackagePrice, 2);
                    discountPercentage = Cart.SubTotal > 0
                        ? Math.Round((Cart.OverallDiscount / Cart.SubTotal) * 100m, 1)
                        : 0;
                }
                else
                {
                    Cart.OverallDiscount = 0;
                    discountPercentage = 0;
                }
            }
            paidAmount = Cart.GrandTotal;
            CloseBundlesModal();
            TriggerAlert(
                title: "🎁 تم تطبيق البكج بنجاح",
                message: $"تمت إضافة أصناف بكج <strong>{offer.TitleAr}</strong> إلى السلة بنجاح." +
                         (offer.PackagePrice > 0 ? $" سعر الباقة: <strong>{offer.PackagePrice:N2} ج.م</strong>" : ""),
                alertType: "warning",
                icon: "fa-gift",
                dedupKey: $"offer_{offer.Id}");
            return;
        }

        // 2. Brand Discount: Apply ONLY to cart items matching target brand
        if (isBrand)
        {
            var matchingItems = Cart.Items.Where(i => 
                (offer.TargetBrandId.HasValue && i.BrandId == offer.TargetBrandId.Value) ||
                (!string.IsNullOrWhiteSpace(offer.TargetBrandName) && !string.IsNullOrWhiteSpace(i.BrandName) &&
                 string.Equals(i.BrandName.Trim(), offer.TargetBrandName.Trim(), StringComparison.OrdinalIgnoreCase))
            ).ToList();

            if (!matchingItems.Any())
            {
                CloseBundlesModal();
                TriggerAlert(
                    title: "⚠️ لم يتم تطبيق الخصم",
                    message: $"لا توجد منتجات في السلة تنتمي لماركة <strong>{offer.TargetBrandName ?? "المحددة"}</strong>.<br/>يرجى إضافة منتجات تابعة لهذه الماركة أولاً لتطبيق الخصم عليها.",
                    alertType: "danger",
                    icon: "fa-triangle-exclamation",
                    dedupKey: $"offer_warn_{offer.Id}");
                return;
            }

            decimal totalAppliedDiscount = 0;
            foreach (var item in matchingItems)
            {
                if (offer.DiscountPercent > 0)
                {
                    item.Discount = Math.Round(item.LineSubtotal * (offer.DiscountPercent / 100m), 2);
                }
                else if (offer.DiscountAmount > 0)
                {
                    item.Discount = Math.Round(Math.Min(item.LineSubtotal, offer.DiscountAmount), 2);
                }
                item.AppliedOfferTitle = offer.TitleAr;
                totalAppliedDiscount += item.Discount;
            }

            paidAmount = Cart.GrandTotal;
            CloseBundlesModal();
            TriggerAlert(
                title: "🏷️ تم تطبيق خصم الماركة",
                message: $"تم تطبيق خصم <strong>{offer.TitleAr}</strong> على ({matchingItems.Count}) منتج ينتمي لماركة <strong>{offer.TargetBrandName}</strong> بإجمالي خصم: <strong>{totalAppliedDiscount:N2} ج.م</strong>.",
                alertType: "warning",
                icon: "fa-tag",
                dedupKey: $"offer_{offer.Id}");
            return;
        }

        // 3. Category Discount: Apply ONLY to cart items matching target category
        if (isCategory)
        {
            var matchingItems = Cart.Items.Where(i => 
                (offer.TargetCategoryId.HasValue && i.CategoryId == offer.TargetCategoryId.Value) ||
                (!string.IsNullOrWhiteSpace(offer.TargetCategoryName) && !string.IsNullOrWhiteSpace(i.CategoryName) &&
                 string.Equals(i.CategoryName.Trim(), offer.TargetCategoryName.Trim(), StringComparison.OrdinalIgnoreCase))
            ).ToList();

            if (!matchingItems.Any())
            {
                CloseBundlesModal();
                TriggerAlert(
                    title: "⚠️ لم يتم تطبيق الخصم",
                    message: $"لا توجد منتجات في السلة تنتمي لتصنيف <strong>{offer.TargetCategoryName ?? "المحدد"}</strong>.<br/>يرجى إضافة منتجات من هذا التصنيف إلى السلة أولاً لتطبيق الخصم عليها.",
                    alertType: "danger",
                    icon: "fa-triangle-exclamation",
                    dedupKey: $"offer_warn_{offer.Id}");
                return;
            }

            decimal totalAppliedDiscount = 0;
            foreach (var item in matchingItems)
            {
                if (offer.DiscountPercent > 0)
                {
                    item.Discount = Math.Round(item.LineSubtotal * (offer.DiscountPercent / 100m), 2);
                }
                else if (offer.DiscountAmount > 0)
                {
                    item.Discount = Math.Round(Math.Min(item.LineSubtotal, offer.DiscountAmount), 2);
                }
                item.AppliedOfferTitle = offer.TitleAr;
                totalAppliedDiscount += item.Discount;
            }

            paidAmount = Cart.GrandTotal;
            CloseBundlesModal();
            TriggerAlert(
                title: "📂 تم تطبيق خصم التصنيف",
                message: $"تم تطبيق خصم <strong>{offer.TitleAr}</strong> على ({matchingItems.Count}) منتج ينتمي لتصنيف <strong>{offer.TargetCategoryName}</strong> بإجمالي خصم: <strong>{totalAppliedDiscount:N2} ج.م</strong>.",
                alertType: "warning",
                icon: "fa-folder-open",
                dedupKey: $"offer_{offer.Id}");
            return;
        }

        // 4. Product Discount: Apply ONLY to target product (auto-add if missing)
        if (isProduct)
        {
            var matchedItem = Cart.Items.FirstOrDefault(i => i.ProductId == offer.TargetProductId);
            if (matchedItem == null && offer.TargetProductId.HasValue)
            {
                var prod = products.FirstOrDefault(p => p.Id == offer.TargetProductId.Value);
                if (prod != null)
                {
                    AddToCart(prod);
                    matchedItem = Cart.Items.FirstOrDefault(i => i.ProductId == offer.TargetProductId.Value);
                }
            }

            if (matchedItem != null)
            {
                if (offer.DiscountPercent > 0)
                {
                    matchedItem.Discount = Math.Round(matchedItem.LineSubtotal * (offer.DiscountPercent / 100m), 2);
                }
                else if (offer.DiscountAmount > 0)
                {
                    matchedItem.Discount = Math.Round(Math.Min(matchedItem.LineSubtotal, offer.DiscountAmount), 2);
                }
                matchedItem.AppliedOfferTitle = offer.TitleAr;
                paidAmount = Cart.GrandTotal;
                CloseBundlesModal();
                TriggerAlert(
                    title: "📦 تم تطبيق خصم المنتج",
                    message: $"تم تطبيق خصم <strong>{offer.TitleAr}</strong> على <strong>{matchedItem.ProductName}</strong> بمقدار: <strong>{matchedItem.Discount:N2} ج.م</strong>.",
                    alertType: "warning",
                    icon: "fa-box",
                    dedupKey: $"offer_{offer.Id}");
                return;
            }
            else
            {
                CloseBundlesModal();
                TriggerAlert(
                    title: "⚠️ لم يتم العثور على المنتج",
                    message: "المنتج المستهدف بالعرض غير متوفر في الكتالوج الحالي.",
                    alertType: "danger",
                    icon: "fa-circle-xmark",
                    dedupKey: $"offer_warn_{offer.Id}");
                return;
            }
        }

        // Fallback: General Cart Discount
        if (offer.DiscountPercent > 0)
        {
            discountPercentage = offer.DiscountPercent;
            ApplyDiscountPercent(offer.DiscountPercent);
        }
        else if (offer.DiscountAmount > 0)
        {
            Cart.OverallDiscount = offer.DiscountAmount;
            discountPercentage = Cart.SubTotal > 0
                ? Math.Round((Cart.OverallDiscount / Cart.SubTotal) * 100m, 1)
                : 0;
        }

        paidAmount = Cart.GrandTotal;
        CloseBundlesModal();
        TriggerAlert(
            title: "🎁 تم تطبيق العرض بنجاح",
            message: $"تم تطبيق عرض <strong>{offer.TitleAr}</strong> بنجاح.",
            alertType: "warning",
            icon: "fa-gift",
            dedupKey: $"offer_{offer.Id}");
    }


    private async Task SubmitSale()
    {
        if (!Shift.IsShiftOpen)
        {
            saleError = "لا يمكن إتمام البيع: لا توجد وردية مفتوحة حالياً. الرجاء فتح وردية أولاً من صفحة الورديات.";
            return;
        }

        if (Cart.PaymentMethod == "Installment")
        {
            if (Cart.CustomerId == null)
            {
                saleError = "يلزم تحديد عميل مسجل لإصدار عقد وجدول التقسيط.";
                await OpenCustomerModal();
                return;
            }
            if (paidAmount >= Cart.GrandTotal)
            {
                saleError = "المبلغ المدفوع يغطي كامل الفاتورة، يرجى اختيار الدفع نقداً أو تقليل المقدم.";
                return;
            }
        }
        else if (paidAmount + 0.01m < Cart.GrandTotal)
        {
            if (Cart.CustomerId == null)
            {
                saleError = "المبلغ المدفوع أقل من الإجمالي. يرجى اختيار أو إضافة عميل لتسجيل المبلغ المتبقي كمديونية بالآجل.";
                await OpenCustomerModal();
                return;
            }

            // يتم اعتماد طريقة الدفع كـ آجل/مديونية
            Cart.PaymentMethod = "Credit";
        }

        if (isDelivery && string.IsNullOrWhiteSpace(deliveryAddress) && string.IsNullOrWhiteSpace(recipientPhone))
        {
            saleError = "يرجى كتابة عنوان التوصيل أو هاتف المستلم لتفعيل خدمة الشحن والتوصيل.";
            return;
        }

        isProcessingSale = true;
        saleError = null;

        try
        {
            var saleItems = Cart.Items.Select(i => new CreateSaleItemRequest(
                i.ProductId,
                i.Quantity,
                i.UnitPrice,
                i.Discount,
                i.LineTax,
                i.SerialNumber)).ToList();

            var cmd = new CreateSaleCommand(
                CashierId: AuthState.UserId,
                ShiftId: Shift.ShiftId,
                Items: saleItems,
                CustomerId: Cart.CustomerId,
                DiscountAmount: Cart.TotalDiscount,
                TaxAmount: Cart.TotalTax,
                PaidAmount: paidAmount,
                PaymentMethod: Cart.PaymentMethod,
                Notes: null,
                IsDelivery: isDelivery,
                RecipientName: isDelivery ? (string.IsNullOrWhiteSpace(recipientName) ? Cart.CustomerName : recipientName) : null,
                RecipientPhone: isDelivery ? recipientPhone : null,
                DeliveryAddress: isDelivery ? deliveryAddress : null,
                DeliveryFloor: isDelivery ? deliveryFloor : null,
                DeliveryFee: isDelivery ? deliveryFee : 0,
                DriverName: isDelivery ? driverName : null,
                IsReserved: isReserved,
                TargetDeliveryDate: isReserved ? targetDeliveryDate : null,
                IsInstallment: Cart.PaymentMethod == "Installment",
                GuarantorName: Cart.PaymentMethod == "Installment" ? guarantorName : null,
                GuarantorPhone: Cart.PaymentMethod == "Installment" ? guarantorPhone : null,
                GuarantorNationalId: Cart.PaymentMethod == "Installment" ? guarantorNationalId : null,
                GuarantorAddress: Cart.PaymentMethod == "Installment" ? guarantorAddress : null,
                GuarantorNotes: Cart.PaymentMethod == "Installment" ? guarantorNotes : null,
                InterestPercentage: Cart.PaymentMethod == "Installment" ? interestPercentage : 0,
                NumberOfMonths: Cart.PaymentMethod == "Installment" ? installmentMonths : 12,
                InstallmentStartDate: Cart.PaymentMethod == "Installment" ? installmentStartDate : null);

            var (saleResult, error) = await ApiClient.CreateSaleAsync(cmd);
            if (saleResult != null)
            {
                var createdId = saleResult.SaleId;
                Cart.Clear();
                ClosePaymentModal();

                if (StoreState.AutoPrintInvoiceAfterSale)
                {
                    await Printer.PrintInvoiceAsync(createdId);
                }
                await FocusBarcodeAsync(100);

                // Auto-refresh product stock balances on the same page
                await LoadCatalogAsync();

                // Trigger instant cloud sync to push updated stock quantities for mobile alerts
                CloudSync.RecordLocalChange();
                _ = Task.Run(async () =>
                {
                    try { await CloudSync.SyncNowAsync(forceCatalogPush: true); } catch { }
                });

                // Depleted batches alert modal (controlled via Settings - EnableDepletedBatchAlert)
                if (StoreState.EnableDepletedBatchAlert && saleResult.DepletedBatches != null && saleResult.DepletedBatches.Count > 0)
                {
                    ShowDepletedBatchesModal(saleResult.DepletedBatches);
                }
            }
            else
            {
                saleError = !string.IsNullOrEmpty(error) ? error : "فشل إنشاء عملية البيع. الرجاء مراجعة الوردية الحالية.";
            }
        }
        catch (Exception ex)
        {
            saleError = $"خطأ في عملية البيع: {ex.Message}";
        }
        finally
        {
            isProcessingSale = false;
        }
    }

    private async Task TogglePrinter()
    {
        var newState = !StoreState.AutoPrintInvoiceAfterSale;
        await StoreState.SetAutoPrintAsync(newState, ApiClient, JS);
    }

    // Customer Modal State
    private bool showCustomerModal = false;
    private string customerTab = "select";
    private List<CustomerDto> allCustomers = new();
    private List<CustomerDto> filteredCustomers = new();
    private string customerSearchQuery = string.Empty;
    private string customerError = string.Empty;
    private bool isSavingCustomer = false;

    private string newCustomerName = string.Empty;
    private string newCustomerPhone = string.Empty;
    private string? newCustomerEmail;
    private string? newCustomerAddress;

    private async Task OpenCustomerModal()
    {
        customerError = string.Empty;
        customerTab = "select";
        customerSearchQuery = string.Empty;
        newCustomerName = string.Empty;
        newCustomerPhone = string.Empty;
        newCustomerEmail = null;
        newCustomerAddress = null;
        allCustomers = await ApiClient.GetCustomersAsync();
        filteredCustomers = allCustomers.ToList();
        showCustomerModal = true;
        _ = FocusCustomerSearchAsync();
    }

    private async Task FocusCustomerSearchAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("focusElementById", "pos-customer-search-input", 60, true);
        }
        catch { }
    }

    private void CloseCustomerModal()
    {
        showCustomerModal = false;
        _ = FocusBarcodeAsync();
    }

    private void FilterCustomers()
    {
        if (string.IsNullOrWhiteSpace(customerSearchQuery))
        {
            filteredCustomers = allCustomers.ToList();
        }
        else
        {
            filteredCustomers = allCustomers.Where(c =>
                c.Name.Contains(customerSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Phone.Contains(customerSearchQuery)).ToList();
        }
    }

    private void SelectCustomer(CustomerDto cust)
    {
        Cart.CustomerId = cust.Id;
        Cart.CustomerName = cust.Name;
        CloseCustomerModal();
    }

    private void SelectWalkInCustomer()
    {
        Cart.CustomerId = null;
        Cart.CustomerName = "Walk-in Customer";
        CloseCustomerModal();
    }

    private async Task SaveNewCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomerName))
        {
            customerError = "الرجاء إدخال اسم العميل.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newCustomerPhone))
        {
            customerError = "الرجاء إدخال رقم هاتف العميل.";
            return;
        }

        isSavingCustomer = true;
        customerError = string.Empty;

        var req = new CreateCustomerRequest(newCustomerName, newCustomerPhone, newCustomerEmail, newCustomerAddress);
        var (id, error) = await ApiClient.CreateCustomerAsync(req);
        isSavingCustomer = false;

        if (id.HasValue)
        {
            Cart.CustomerId = id.Value;
            Cart.CustomerName = newCustomerName;
            CloseCustomerModal();
        }
        else
        {
            customerError = !string.IsNullOrEmpty(error) ? error : "فشل إضافة العميل.";
        }
    }

    private DotNetObjectReference<POS>? _dotNetRef;
    private bool isProductReviewExpanded = true;

    private void ToggleProductReview()
    {
        isProductReviewExpanded = !isProductReviewExpanded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initPosPageShortcuts", _dotNetRef);
                await FocusBarcodeAsync(50);
            }
            catch
            {
                // Fallback if JS call fails
            }
        }
    }

    [JSInvokable]
    public async Task OnPosShortcutPressed(string key)
    {
        if (key == "F2")
        {
            if (showCustomerModal)
            {
                CloseCustomerModal();
            }
            else
            {
                await OpenCustomerModal();
            }
        }
        else if (key == "Enter")
        {
            if (showPaymentModal && !isProcessingSale)
            {
                await SubmitSale();
            }
            else if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
            {
                OpenPaymentModal();
            }
        }
        else if (key == "F4" || key == "F8")
        {
            if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
            {
                OpenPaymentModal();
            }
        }
        else if (key == "F9")
        {
            if (Cart.Items.Any())
            {
                Cart.Clear();
            }
            await FocusBarcodeAsync();
        }
        else if (key == "Escape")
        {
            if (showPaymentModal)
            {
                ClosePaymentModal();
            }
            else if (showCustomerModal)
            {
                CloseCustomerModal();
            }
            else if (Cart.Items.Any())
            {
                Cart.Clear();
                await FocusBarcodeAsync();
            }
            else
            {
                await FocusBarcodeAsync();
            }
        }
        StateHasChanged();
    }

    private string GetImageFullUrl(string? relativeOrUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeOrUrl)) return string.Empty;
        return ApiClient.GetImageFullUrl(relativeOrUrl);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        Cart.OnCartChanged -= StateHasChanged;
    }
}
