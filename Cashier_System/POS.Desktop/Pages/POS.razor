    private void ApplyDiscountPercent(decimal percent)
    {
        discountPercentage = Math.Clamp(percent, 0, 100);
        decimal discountAmount = Math.Round(Cart.SubTotal * (discountPercentage / 100m), 2);
        Cart.OverallDiscount = discountAmount;
        paidAmount = Cart.GrandTotal;
    }

