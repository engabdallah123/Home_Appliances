@page "/price-check"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject IJSRuntime JS

<div class="price-check-container">
    <!-- Header -->
    <div class="price-check-header">
        <div class="header-icon">
            <i class="fa-solid fa-tag"></i>
        </div>
        <div>
            <h2>شاشة الاستعلام عن سعر المنتج</h2>
            <p>ابحث باسم المنتج أو الجهاز للاستعلام الفوري عن سعر البيع والجملة وحالة التوفر بالمخزن</p>
        </div>
    </div>

    <!-- Search Input Box (Name Search Only) -->
    <div class="search-scanner-card">
        <div class="input-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input id="price-check-name-input"
                   @ref="nameInput"
                   type="text"
                   class="scanner-input"
                   placeholder="اكتب اسم المنتج أو الجهاز هنا للاستعلام عن سعره..."
                   @bind="searchNameQuery"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp"
                   autocomplete="off" />

            @if (!string.IsNullOrWhiteSpace(searchNameQuery))
            {
                <button class="clear-btn" @onclick="ClearSearch" title="مسح">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            }
        </div>

        <!-- Live Instant Suggestions Dropdown -->
        @if (!string.IsNullOrWhiteSpace(searchNameQuery) && MatchingProducts.Any())
        {
            <div class="live-suggestions-panel">
                <div class="suggestions-header">
                    <span>نتائج البحث المطابقة (@MatchingProducts.Count()):</span>
                    <span class="hint-text">اضغط على الصنف لعرض بطاقة السعر بالكامل</span>
                </div>
                <div class="suggestions-list">
                    @foreach (var p in MatchingProducts.Take(12))
                    {
                        <div class="suggestion-item @(selectedProduct?.Id == p.Id ? "active" : "")" @onclick="() => SelectProduct(p)">
                            <div class="item-info">
                                <div class="item-name">
                                    <span class="name-ar">@p.NameAr</span>
                                    @if (!string.IsNullOrWhiteSpace(p.NameEn))
                                    {
                                        <span class="name-en">@p.NameEn</span>
                                    }
                                </div>
                                <div class="item-meta">
                                    @if (!string.IsNullOrWhiteSpace(p.BrandName))
                                    {
                                        <span class="meta-tag brand-tag"><i class="fa-solid fa-award"></i> @p.BrandName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.CategoryName))
                                    {
                                        <span class="meta-tag"><i class="fa-solid fa-tags"></i> @p.CategoryName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.Barcode))
                                    {
                                        <span class="meta-tag barcode-tag"><i class="fa-solid fa-barcode"></i> @p.Barcode</span>
                                    }
                                </div>
                            </div>

                            <div class="item-pricing">
                                <span class="price-val">@p.SellingPrice.ToString("N2") ج.م</span>
                                @if (p.QuantityInStock > 0)
                                {
                                    <span class="stock-badge in-stock"><i class="fa-solid fa-check"></i> متوفر (@p.QuantityInStock.ToString("N0"))</span>
                                }
                                else
                                {
                                    <span class="stock-badge out-stock"><i class="fa-solid fa-xmark"></i> نفد المخزون</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="action-buttons">
            <button class="btn btn-search" @onclick="SelectFirstMatchOrSearch" disabled="@(isLoading || string.IsNullOrWhiteSpace(searchNameQuery))">
                <i class="fa-solid fa-magnifying-glass"></i> استعلام مباشر (Enter)
            </button>
            <button class="btn btn-reset" @onclick="ClearSearch">
                <i class="fa-solid fa-rotate-left"></i> تفريغ البحث
            </button>
        </div>
    </div>

    <!-- Main Results Area -->
    @if (isLoading)
    {
        <div class="state-card loading-state">
            <i class="fa-solid fa-circle-notch fa-spin fa-3x text-accent"></i>
            <p>جاري البحث واسترجاع تفاصيل المنتج والسعر...</p>
        </div>
    }
    else if (selectedProduct is not null)
    {
        <div class="product-result-card">
            <!-- Left Side: Product Image & Stock Status -->
            <div class="product-media-column">
                <div class="image-container">
                    @if (!string.IsNullOrWhiteSpace(selectedProduct.ImageUrl))
                    {
                        <img src="@ApiClient.GetImageFullUrl(selectedProduct.ImageUrl)" alt="@selectedProduct.NameAr" class="product-img" onerror="this.onerror=null; this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                        <div class="no-image-placeholder" style="display:none;">
                            <i class="fa-solid fa-box-open fa-3x"></i>
                            <span>صورة المنتج</span>
                        </div>
                    }
                    else
                    {
                        <div class="no-image-placeholder">
                            <i class="fa-solid fa-box-open fa-3x"></i>
                            <span>صورة المنتج</span>
                        </div>
                    }
                </div>

                <div class="product-media-stock-text">
                    @if (selectedProduct.QuantityInStock > 0)
                    {
                        <span class="stock-text-available">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            <span>متوفر بالمخزن: <strong>@selectedProduct.QuantityInStock.ToString("N0") @(selectedProduct.UnitSymbol ?? "قطعة")</strong></span>
                        </span>
                    }
                    else
                    {
                        <span class="stock-text-out">
                            <i class="fa-solid fa-circle-xmark"></i>
                            <span>غير متوفر بالمخزن (0)</span>
                        </span>
                    }
                </div>
            </div>

            <!-- Right Side: Details & High Impact Price Tag -->
            <div class="product-details-column">
                <!-- Price Display Hero Box -->
                <div class="price-hero-card">
                    <div class="price-hero-header">
                        <span><i class="fa-solid fa-tag"></i> سعر البيع النهائي للعميل</span>
                        <span class="tax-badge">
                            @(selectedProduct.TaxRate > 0 ? $"شامل ضريبة {selectedProduct.TaxRate}%" : "معفى من الضريبة")
                        </span>
                    </div>

                    <div class="price-main-display">
                        <span class="price-amount">@selectedProduct.SellingPrice.ToString("N2")</span>
                        <span class="price-currency">ج.م</span>
                    </div>

                    <div class="price-sub-details">
                        @if (selectedProduct.WholesalePrice > 0)
                        {
                            <span class="sub-detail-item">
                                <i class="fa-solid fa-boxes-packing"></i> سعر الجملة: <strong>@selectedProduct.WholesalePrice.ToString("N2") ج.م</strong>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedProduct.UnitSymbol))
                        {
                            <span class="sub-detail-item">
                                <i class="fa-solid fa-scale-unbalanced"></i> وحدة البيع: <strong>@selectedProduct.UnitSymbol</strong>
                            </span>
                        }
                    </div>
                </div>

                <!-- Product Attributes Grid -->
                <div class="attributes-grid">
                    <div class="attr-box full-span">
                        <span class="attr-label">اسم المنتج</span>
                        <span class="attr-val font-title">@selectedProduct.NameAr</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.NameEn))
                    {
                        <div class="attr-box full-span">
                            <span class="attr-label">الاسم بالإنجليزية</span>
                            <span class="attr-val">@selectedProduct.NameEn</span>
                        </div>
                    }

                    <div class="attr-box">
                        <span class="attr-label">التصنيف</span>
                        <span class="attr-val">@(selectedProduct.CategoryName ?? "غير محدد")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.BrandName))
                    {
                        <div class="attr-box">
                            <span class="attr-label">الماركة / التوكيل</span>
                            <span class="attr-val brand-val">
                                <i class="fa-solid fa-award me-1"></i> @selectedProduct.BrandName
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.ModelNumber))
                    {
                        <div class="attr-box">
                            <span class="attr-label">الموديل / الكود الفني</span>
                            <span class="attr-val"><code>@selectedProduct.ModelNumber</code></span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.Color))
                    {
                        <div class="attr-box">
                            <span class="attr-label">اللون</span>
                            <span class="attr-val"><i class="fa-solid fa-palette me-1"></i> @selectedProduct.Color</span>
                        </div>
                    }

                    <div class="attr-box">
                        <span class="attr-label">الكمية بالمخزن</span>
                        <span class="attr-val" style="color: @(selectedProduct.QuantityInStock > 0 ? "var(--accent-green)" : "var(--accent-red)"); font-weight: 800;">
                            <i class="fa-solid @(selectedProduct.QuantityInStock > 0 ? "fa-cubes" : "fa-circle-xmark") me-1"></i>
                            @selectedProduct.QuantityInStock.ToString("N0") @(selectedProduct.UnitSymbol ?? "قطعة")
                        </span>
                    </div>

                    <div class="attr-box">
                        <span class="attr-label">فترة الضمان</span>
                        <span class="attr-val" style="color: var(--accent-blue); font-weight: 700;">
                            <i class="fa-solid fa-shield-halved me-1"></i> @(selectedProduct.WarrantyPeriodMonths > 0 ? $"{selectedProduct.WarrantyPeriodMonths} شهر" : "بدون ضمان")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.MaintenanceAgent))
                    {
                        <div class="attr-box">
                            <span class="attr-label">مركز الصيانة وخدمة العملاء</span>
                            <span class="attr-val"><i class="fa-solid fa-headset me-1"></i> @selectedProduct.MaintenanceAgent</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(selectedProduct.Barcode))
                    {
                        <div class="attr-box">
                            <span class="attr-label">كود الباركود</span>
                            <span class="attr-val barcode-font"><i class="fa-solid fa-barcode"></i> @selectedProduct.Barcode</span>
                        </div>
                    }
                </div>

                <!-- Tags / Attributes Flags -->
                <div class="flags-container">
                    @if (selectedProduct.HasSerialNumber)
                    {
                        <span class="flag-chip chip-amber"><i class="fa-solid fa-barcode"></i> متتبع بسيريال نمبر (S/N)</span>
                    }
                    @if (selectedProduct.WarrantyPeriodMonths > 0)
                    {
                        <span class="flag-chip chip-blue"><i class="fa-solid fa-shield-halved"></i> ضمان معتمد @selectedProduct.WarrantyPeriodMonths شهر</span>
                    }
                    @if (selectedProduct.IsActive)
                    {
                        <span class="flag-chip chip-green"><i class="fa-solid fa-check"></i> منتج متاح للبيع</span>
                    }
                </div>

                <!-- Action Footer -->
                <div class="result-action-footer">
                    <button class="btn btn-scan-next" @onclick="ClearAndFocus">
                        <i class="fa-solid fa-magnifying-glass"></i> الاستعلام عن منتج آخر (بحث جديد)
                    </button>
                </div>
            </div>
        </div>
    }
    else if (hasSearched && !MatchingProducts.Any())
    {
        <div class="state-card not-found-state">
            <div class="not-found-icon">
                <i class="fa-solid fa-face-frown fa-4x text-red"></i>
            </div>
            <h3>لم يتم العثور على أي منتج بهذا الاسم!</h3>
            <p>تأكد من كتابة اسم المنتج بشكل صحيح أو جرب كلمات بحث أخرى</p>

            <button class="btn btn-scan-next" @onclick="ClearAndFocus" style="margin-top: 1rem;">
                <i class="fa-solid fa-rotate-left"></i> المحاولة مرة أخرى
            </button>
        </div>
    }
    else
    {
        <!-- Initial Standby Screen -->
        <div class="state-card standby-state">
            <div class="standby-icon">
                <i class="fa-solid fa-magnifying-glass fa-4x text-indigo"></i>
            </div>
            <h3>شاشة الاستعلام عن الأسعار جاهزة</h3>
            <p>ابدأ بكتابة اسم المنتج أو الجهاز في خانة البحث أعلاه لعرض السعر والمواصفات فوراً</p>
        </div>
    }
</div>

<style>
    .price-check-container {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 2rem;
    }

    .price-check-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 1.25rem 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
    }

    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
        flex-shrink: 0;
    }

    .price-check-header h2 {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0;
    }

    .price-check-header p {
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-top: 0.2rem;
    }

    /* Search Card */
    .search-scanner-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: var(--shadow-md);
        position: relative;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        right: 1.25rem;
        font-size: 1.3rem;
        color: var(--accent-indigo);
    }

    .scanner-input {
        width: 100%;
        background: var(--bg-secondary);
        border: 2px solid var(--accent-indigo);
        color: var(--text-primary);
        padding: 1rem 3.2rem 1rem 3rem;
        border-radius: 12px;
        font-size: 1.2rem;
        font-weight: 700;
        font-family: var(--font-family);
        outline: none;
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
        transition: all 0.2s ease;
    }

    .scanner-input:focus {
        border-color: var(--accent-blue);
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
    }

    .clear-btn {
        position: absolute;
        left: 1rem;
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0.3rem;
    }
    .clear-btn:hover { color: var(--accent-red); }

    /* Live Suggestions Panel */
    .live-suggestions-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        margin-top: -0.25rem;
    }

    .suggestions-header {
        background: var(--bg-secondary);
        padding: 0.65rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .hint-text {
        font-size: 0.75rem;
        font-weight: normal;
        color: var(--text-muted);
    }

    .suggestions-list {
        max-height: 280px;
        overflow-y: auto;
    }

    .suggestion-item {
        padding: 0.85rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .suggestion-item:last-child {
        border-bottom: none;
    }

    .suggestion-item:hover, .suggestion-item.active {
        background: var(--bg-card-hover);
    }

    .item-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .item-name {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .name-ar {
        font-size: 0.98rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .name-en {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .item-meta {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .meta-tag {
        font-size: 0.75rem;
        color: var(--text-secondary);
        background: var(--bg-secondary);
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        border: 1px solid var(--border-color);
    }

    .brand-tag {
        color: var(--accent-indigo);
        font-weight: 600;
    }

    .barcode-tag {
        font-family: monospace;
    }

    .item-pricing {
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
    }

    .price-val {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--accent-emerald);
    }

    .stock-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
    }

    .stock-badge.in-stock {
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
    }

    .stock-badge.out-stock {
        background: rgba(239, 68, 68, 0.15);
        color: var(--accent-red);
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-search {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-reset {
        background: var(--bg-secondary);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* States */
    .state-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 4rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
    }

    .standby-state h3, .not-found-state h3 {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text-primary);
    }

    .standby-state p, .not-found-state p {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    /* Product Result Card */
    .product-result-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 1.75rem;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2rem;
        box-shadow: var(--shadow-lg);
    }

    .product-media-column {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        align-items: center;
    }

    .image-container {
        width: 100%;
        height: 240px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .no-image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 600;
        width: 100%;
        height: 100%;
    }

    .product-media-stock-text {
        width: 100%;
        text-align: center;
        padding: 0.65rem 0.85rem;
        border-radius: 12px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stock-text-available {
        color: var(--accent-green);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
    }

    .stock-text-available strong {
        font-weight: 800;
        font-size: 1.05rem;
    }

    .stock-text-out {
        color: var(--accent-red);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 700;
    }

    .product-details-column {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* Price Hero Card */
    .price-hero-card {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(56, 189, 248, 0.12));
        border: 2px solid var(--accent-indigo);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.15);
    }

    .price-hero-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent-indigo);
    }

    .tax-badge {
        background: var(--bg-card);
        color: var(--text-secondary);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-size: 0.75rem;
        border: 1px solid var(--border-color);
    }

    .price-main-display {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .price-amount {
        font-size: 3rem;
        font-weight: 900;
        color: var(--accent-emerald);
        letter-spacing: -1px;
        line-height: 1;
    }

    .price-currency {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-secondary);
    }

    .price-sub-details {
        display: flex;
        gap: 1.5rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
        border-top: 1px dashed var(--border-color);
        padding-top: 0.6rem;
    }

    .attributes-grid {
