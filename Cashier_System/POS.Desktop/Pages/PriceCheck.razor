@code {
    private ElementReference nameInput;
    private string searchNameQuery = string.Empty;
    private bool isLoading = false;
    private bool hasSearched = false;
    private ProductDto? selectedProduct;
    private List<ProductDto> allProducts = new();

    private IEnumerable<ProductDto> MatchingProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchNameQuery))
                return Enumerable.Empty<ProductDto>();

            var q = searchNameQuery.Trim();
            return allProducts.Where(p =>
                (p.NameAr != null && p.NameAr.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (p.NameEn != null && p.NameEn.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllProductsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusSearchInputAsync(50, true);
        }
    }

    private async Task LoadAllProductsAsync()
    {
        try
        {
            allProducts = await ApiClient.GetProductsAsync();
        }
        catch
        {
            allProducts = new();
        }
    }

    private async Task FocusSearchInputAsync(int delay = 0, bool select = true)
    {
        try
        {
            await JS.InvokeVoidAsync("focusElementById", "price-check-name-input", delay, select);
        }
        catch
        {
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SelectFirstMatchOrSearch();
        }
    }

    private async Task SelectFirstMatchOrSearch()
    {
        if (string.IsNullOrWhiteSpace(searchNameQuery)) return;

        hasSearched = true;
        var firstMatch = MatchingProducts.FirstOrDefault();
        if (firstMatch is not null)
        {
            SelectProduct(firstMatch);
            return;
        }

        // If not in in-memory list, try fetching from API
        isLoading = true;
        selectedProduct = null;
        StateHasChanged();

        try
        {
            var results = await ApiClient.GetProductsAsync(searchNameQuery.Trim());
            selectedProduct = results.FirstOrDefault(p =>
                (p.NameAr != null && p.NameAr.Contains(searchNameQuery.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (p.NameEn != null && p.NameEn.Contains(searchNameQuery.Trim(), StringComparison.OrdinalIgnoreCase)));
        }
        catch
        {
            selectedProduct = null;
        }

        isLoading = false;
        StateHasChanged();
        await FocusSearchInputAsync(50, true);
    }

    private void SelectProduct(ProductDto p)
    {
        selectedProduct = p;
        hasSearched = true;
        searchNameQuery = p.NameAr;
        StateHasChanged();
    }

    private async Task ClearSearch()
    {
        searchNameQuery = string.Empty;
        selectedProduct = null;
        hasSearched = false;
        await FocusSearchInputAsync(0, true);
    }

    private async Task ClearAndFocus()
    {
        await ClearSearch();
    }
}
