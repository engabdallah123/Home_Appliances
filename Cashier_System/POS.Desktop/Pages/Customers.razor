@if (showAddCustomerModal)
{
    <div class="modal-overlay" @onclick="() => showAddCustomerModal = false" style="z-index: 1050;">
        <div class="modal-card" style="width: 480px; max-width: 95vw;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-user-plus text-indigo me-2"></i> إضافة عميل جديد
                </h3>
                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.55rem;" @onclick="() => showAddCustomerModal = false">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.85rem;">
                @if (!string.IsNullOrEmpty(newCustomerError))
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; padding: 0.6rem 0.85rem; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @newCustomerError
                    </div>
                }

                <div class="form-group" style="margin: 0;">
                    <label style="font-size: 0.82rem; font-weight: 700; margin-bottom: 0.25rem; display: block;">اسم العميل <span style="color: var(--accent-red);">*</span></label>
                    <input type="text" class="form-control" @bind="newCustomerName" placeholder="أدخل اسم العميل بالكامل..." />
                </div>

                <div class="form-group" style="margin: 0;">
                    <label style="font-size: 0.82rem; font-weight: 700; margin-bottom: 0.25rem; display: block;">رقم الهاتف / الواتساب <span style="color: var(--accent-red);">*</span></label>
                    <input type="text" class="form-control" @bind="newCustomerPhone" placeholder="010xxxxxxxx" dir="ltr" style="text-align: left;" />
                </div>

                <div class="form-group" style="margin: 0;">
                    <label style="font-size: 0.82rem; font-weight: 700; margin-bottom: 0.25rem; display: block;">العنوان ومحل الإقامة</label>
                    <input type="text" class="form-control" @bind="newCustomerAddress" placeholder="المدينة، الشارع، أو علامة مميزة..." />
                </div>

                <div class="form-group" style="margin: 0;">
                    <label style="font-size: 0.82rem; font-weight: 700; margin-bottom: 0.25rem; display: block;">البريد الإلكتروني (اختياري)</label>
                    <input type="email" class="form-control" @bind="newCustomerEmail" placeholder="example@mail.com" dir="ltr" style="text-align: left;" />
                </div>
            </div>

            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 0.6rem; padding: 0.75rem 1.25rem; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary" @onclick="() => showAddCustomerModal = false" disabled="@isSavingCustomer">إلغاء</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewCustomerAsync" disabled="@isSavingCustomer">
                    @if (isSavingCustomer)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>حفظ العميل</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

