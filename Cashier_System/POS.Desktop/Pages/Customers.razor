@if (selectedDebtToPay != null)
{
    <div class="modal-overlay" @onclick="() => selectedDebtToPay = null" style="z-index: 1060;">
        <div class="modal-card" style="width: 480px; max-width: 95vw;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-hand-holding-dollar text-red me-2"></i> تحصيل مديونية عميل
                </h3>
                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.55rem;" @onclick="() => selectedDebtToPay = null">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="padding: 1.25rem; display: flex; flex-direction: column; gap: 0.85rem;">
                <div style="background: var(--bg-primary); padding: 0.85rem; border-radius: 6px; font-size: 0.88rem; display: flex; flex-direction: column; gap: 0.35rem;">
                    <div><strong>العميل:</strong> @selectedDebtToPay.CustomerName</div>
                    <div><strong>فاتورة رقم:</strong> <code>@selectedDebtToPay.InvoiceNumber</code></div>
                    <div><strong>إجمالي الفاتورة:</strong> @selectedDebtToPay.TotalAmount.ToString("N2") ج.م</div>
                    <div><strong>المدفوع سابقاً:</strong> <span style="color: var(--accent-emerald);">@selectedDebtToPay.PaidAmount.ToString("N2") ج.م</span></div>
                    <div><strong>المبلغ المتبقي كدين:</strong> <span style="color: #f87171; font-weight: 800;">@selectedDebtToPay.RemainingAmount.ToString("N2") ج.م</span></div>
                </div>

                @if (!string.IsNullOrEmpty(debtPayError))
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; padding: 0.6rem 0.85rem; border-radius: 6px; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @debtPayError
                    </div>
                }

                <div class="form-group" style="margin: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
                        <label style="font-size: 0.82rem; font-weight: 700; margin: 0;">المبلغ المحصل الآن (ج.م) <span style="color: var(--accent-red);">*</span></label>
                        <button type="button" class="btn btn-secondary" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;" @onclick="() => debtPayAmount = selectedDebtToPay.RemainingAmount">
                            كامل المتبقي (@selectedDebtToPay.RemainingAmount.ToString("N2"))
                        </button>
                    </div>
                    <input type="number" step="0.5" min="1" max="@selectedDebtToPay.RemainingAmount" class="form-control" @bind="debtPayAmount" style="font-size: 1.15rem; font-weight: 800; text-align: center; color: var(--accent-emerald);" />
                </div>
            </div>

            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 0.6rem; padding: 0.75rem 1.25rem; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-secondary" @onclick="() => selectedDebtToPay = null" disabled="@isPayingDebt">إلغاء</button>
                <button type="button" class="btn btn-primary" @onclick="SubmitDebtPaymentAsync" disabled="@(isPayingDebt || debtPayAmount <= 0)">
                    @if (isPayingDebt)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري تسجيل التحصيل...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>تأكيد التحصيل وإيداع بالخزينة</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .customers-page {
        padding: 0 0.5rem 2rem 0.5rem;
    }
    .btn-whatsapp-icon:hover {
        background: rgba(16, 185, 129, 0.25) !important;
    }
    .badge-emerald {
        background: rgba(16, 185, 129, 0.15);
        color: var(--accent-emerald);
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
</style>

@code {
    private List<CustomerDto> customers = new();
    private List<CustomerDto> filteredCustomers = new();
    private List<CustomerDebtDto> allDebts = new();
    private List<InstallmentContractDto> installmentContracts = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<CustomerDto> PagedCustomers => filteredCustomers.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredCustomers.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private string filterDebtType = "all"; // all, debt, clear
    private string? alertMessage;
    private bool alertIsError = false;

    private decimal totalDebtsAmount => allDebts.Sum(d => d.RemainingAmount);
    private int customersWithDebtCount => customers.Count(c => GetCustomerTotalDebt(c.Id) > 0);
    private int customersWithCreditDebtCount => customers.Count(c => GetCustomerCreditDebt(c.Id) > 0);
    private decimal totalInstallmentRemaining => installmentContracts.Sum(i => i.RemainingAmount);

    // Customer Dossier
    private CustomerDto? selectedCustomerForDossier;
    private bool isLoadingDossier = false;
    private string dossierActiveTab = "sales";
    private List<SaleDto> customerSalesList = new();
    private List<CustomerDebtDto> customerDebtsList = new();
    private List<InstallmentContractDto> customerInstallmentsList = new();

    // WhatsApp Sender Modal
    private bool showWhatsAppSenderModal = false;
    private CustomerDto? targetCustomerForWhatsApp;
    private string whatsAppTargetPhone = string.Empty;
    private List<SaleDto> availableSalesForWhatsApp = new();
    private SaleDto? selectedSaleForWhatsApp;
    private string whatsAppMessageText = string.Empty;
    private bool isLoadingCustomerSalesForWhatsApp = false;
    private bool isCopied = false;
    private bool isPreparingPdf = false;
    private string? lastSavedPdfPath;
    private string whatsAppSendMode = "pdf"; // "pdf" or "text"

    private void SetWhatsAppSendMode(string mode)
    {
        whatsAppSendMode = mode;
        isCopied = false;
    }

    // Add Customer Modal
    private bool showAddCustomerModal = false;
    private string newCustomerName = string.Empty;
    private string newCustomerPhone = string.Empty;
    private string? newCustomerAddress;
    private string? newCustomerEmail;
    private string? newCustomerError;
    private bool isSavingCustomer = false;

    // Debt Payment Modal
    private CustomerDebtDto? selectedDebtToPay;
    private decimal debtPayAmount;
    private bool isPayingDebt = false;
    private string? debtPayError;

    protected override async Task OnInitializedAsync()
    {
        CloudSync.OnDataImported += HandleSyncDataImported;
        await LoadDataAsync();
    }

    private async void HandleSyncDataImported()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync(silent: true);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CloudSync.OnDataImported -= HandleSyncDataImported;
    }

    private async Task LoadDataAsync(bool silent = false)
    {
        if (!silent) isLoading = true;
        try
        {
            customers = await ApiClient.GetCustomersAsync() ?? new();
            allDebts = await ApiClient.GetCustomerDebtsAsync() ?? new();
            installmentContracts = await ApiClient.GetInstallmentContractsAsync() ?? new();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            alertMessage = $"خطأ أثناء تحميل البيانات: {ex.Message}";
            alertIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private decimal GetCustomerCreditDebt(Guid customerId)
    {
        return allDebts
            .Where(d => d.CustomerId == customerId && d.RemainingAmount > 0)
            .Sum(d => d.RemainingAmount);
    }

    private decimal GetCustomerInstallmentDebt(Guid customerId)
    {
        return installmentContracts
            .Where(i => i.CustomerId == customerId && i.RemainingAmount > 0)
            .Sum(i => i.RemainingAmount);
    }

    private decimal GetCustomerTotalDebt(Guid customerId)
    {
        return GetCustomerCreditDebt(customerId) + GetCustomerInstallmentDebt(customerId);
    }

    private void ApplyFilters()
    {
        var query = customers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(c =>
                (c.Name != null && c.Name.ToLowerInvariant().Contains(q)) ||
                (c.Phone != null && c.Phone.Contains(q)) ||
                (c.Address != null && c.Address.ToLowerInvariant().Contains(q)));
        }

        if (filterDebtType == "debt")
        {
            query = query.Where(c => GetCustomerTotalDebt(c.Id) > 0);
        }
        else if (filterDebtType == "clear")
        {
            query = query.Where(c => GetCustomerTotalDebt(c.Id) <= 0);
        }

        filteredCustomers = query.OrderByDescending(c => GetCustomerTotalDebt(c.Id)).ThenBy(c => c.Name).ToList();
        currentPage = 1;
        EnsureValidPage();
    }

    private void SetFilterType(string type)
    {
        filterDebtType = type;
        ApplyFilters();
    }

    // --- Dossier Operations ---
    private async Task OpenCustomerDossier(CustomerDto cust)
    {
        selectedCustomerForDossier = cust;
        dossierActiveTab = "sales";
        isLoadingDossier = true;

        customerDebtsList = allDebts.Where(d => d.CustomerId == cust.Id).ToList();
        customerInstallmentsList = installmentContracts.Where(i => i.CustomerId == cust.Id).ToList();

        try
        {
            customerSalesList = await ApiClient.GetSalesListAsync(customerId: cust.Id) ?? new();
        }
        catch
        {
            customerSalesList = new();
        }
        finally
        {
            isLoadingDossier = false;
        }
    }

    private void CloseCustomerDossier()
    {
        selectedCustomerForDossier = null;
        customerSalesList.Clear();
        customerDebtsList.Clear();
        customerInstallmentsList.Clear();
    }

    private async Task PrintSale(Guid saleId)
    {
        await Printer.PrintInvoiceAsync(saleId);
    }

    private string FormatPaymentMethod(string method)
    {
        return method switch
        {
            "Cash" => "نقداً",
            "Visa" => "بطاقة / فيزا",
            "Credit" => "آجل (دين)",
            "Installment" => "تقسيط",
            _ => method
        };
    }

    // --- WhatsApp Operations ---
    private async Task OpenSendInvoiceWhatsAppModal(CustomerDto cust)
    {
        targetCustomerForWhatsApp = cust;
        whatsAppTargetPhone = cust.Phone ?? string.Empty;
        showWhatsAppSenderModal = true;
        isLoadingCustomerSalesForWhatsApp = true;
        isCopied = false;
        whatsAppSendMode = "pdf";

        try
        {
            availableSalesForWhatsApp = await ApiClient.GetSalesListAsync(customerId: cust.Id) ?? new();
            if (availableSalesForWhatsApp.Any())
            {
                var first = availableSalesForWhatsApp.First();
                await SelectInvoiceForWhatsApp(first.Id);
            }
            else
            {
                selectedSaleForWhatsApp = null;
                whatsAppMessageText = "لا توجد فواتير بيع مسجلة لهذا العميل حالياً.";
            }
        }
        catch (Exception ex)
        {
            whatsAppMessageText = $"تعذر تحميل فواتير العميل: {ex.Message}";
        }
        finally
        {
            isLoadingCustomerSalesForWhatsApp = false;
        }
    }

    private async Task OnSelectedInvoiceChanged(ChangeEventArgs e)
    {
        if (e.Value != null && Guid.TryParse(e.Value.ToString(), out var saleId))
        {
            await SelectInvoiceForWhatsApp(saleId);
        }
    }

    private async Task SelectInvoiceForWhatsApp(Guid saleId)
    {
        // Fetch detailed sale to ensure line items are present
        var detailedSale = await ApiClient.GetSaleByIdAsync(saleId);
        if (detailedSale != null)
        {
            selectedSaleForWhatsApp = detailedSale;
        }
        else
        {
            selectedSaleForWhatsApp = availableSalesForWhatsApp.FirstOrDefault(s => s.Id == saleId);
        }

        if (selectedSaleForWhatsApp != null)
        {
            InstallmentContractDto? contract = null;
            if (selectedSaleForWhatsApp.IsInstallment || selectedSaleForWhatsApp.InstallmentContractId.HasValue)
            {
                contract = installmentContracts.FirstOrDefault(c => c.SaleId == selectedSaleForWhatsApp.Id || (selectedSaleForWhatsApp.InstallmentContractId.HasValue && c.Id == selectedSaleForWhatsApp.InstallmentContractId.Value));
            }

            whatsAppMessageText = WhatsAppInvoiceHelper.BuildInvoiceMessage(
                selectedSaleForWhatsApp,
                StoreState.StoreName,
                StoreState.Settings?.Phone,
                StoreState.Settings?.InvoiceFooterMessage,
                contract);
        }
    }

    private async Task SendSingleSaleWhatsApp(SaleDto sale, CustomerDto cust)
    {
        targetCustomerForWhatsApp = cust;
        whatsAppTargetPhone = cust.Phone ?? string.Empty;
        showWhatsAppSenderModal = true;
        isLoadingCustomerSalesForWhatsApp = false;
        isCopied = false;
        whatsAppSendMode = "pdf";

        availableSalesForWhatsApp = customerSalesList.Any() ? customerSalesList : new List<SaleDto> { sale };
        await SelectInvoiceForWhatsApp(sale.Id);
    }

    private async Task SendInvoicePdfViaWhatsAppAsync()
    {
        if (selectedSaleForWhatsApp == null) return;
        if (string.IsNullOrWhiteSpace(whatsAppTargetPhone))
        {
            alertMessage = "يرجى إدخال رقم هاتف واتساب للعميل.";
            alertIsError = true;
            return;
        }

        isPreparingPdf = true;
        try
        {
            // 1. Fetch exact PDF bytes from backend (the one used for printing)
            var pdfBytes = await Printer.GetInvoicePdfBytesAsync(selectedSaleForWhatsApp.Id, isThermal: false);

            // 2. Save PDF file to Documents\POS_Invoices
            var filePath = WhatsAppInvoiceHelper.SaveInvoicePdf(pdfBytes, selectedSaleForWhatsApp.InvoiceNumber);
            lastSavedPdfPath = filePath;

            // 3. Copy file to Windows Clipboard (enables Ctrl+V in WhatsApp)
            WhatsAppInvoiceHelper.CopyFileToClipboard(filePath);

            // 4. Open WhatsApp chat with clean intro
            WhatsAppInvoiceHelper.OpenWhatsAppChatForPdf(
                whatsAppTargetPhone,
                selectedSaleForWhatsApp.InvoiceNumber,
                StoreState.StoreName);

            alertMessage = $"📄 تم تجهيز ونسخ ملف الفاتورة ({System.IO.Path.GetFileName(filePath)}) إلى الحافظة بنجاح! بمجرد فتح محادثة الواتساب، اضغط (Ctrl + V) لإرسال الملف للعميل فوراً.";
            alertIsError = false;
            CloseWhatsAppSenderModal();
        }
        catch (Exception ex)
        {
            alertMessage = $"تعذر تجهيز ملف الفاتورة: {ex.Message}";
            alertIsError = true;
        }
        finally
        {
            isPreparingPdf = false;
        }
    }

    private void OpenLastPdfFolder()
    {
        if (!string.IsNullOrEmpty(lastSavedPdfPath))
        {
            WhatsAppInvoiceHelper.ShowFileInExplorer(lastSavedPdfPath);
        }
    }

    private async Task DownloadInvoicePdfDirectly()
    {
        if (selectedSaleForWhatsApp == null) return;
        try
        {
            var pdfBytes = await Printer.GetInvoicePdfBytesAsync(selectedSaleForWhatsApp.Id, isThermal: false);
            var base64 = Convert.ToBase64String(pdfBytes);
            var cleanInv = string.Concat(selectedSaleForWhatsApp.InvoiceNumber.Split(System.IO.Path.GetInvalidFileNameChars()));
            await JS.InvokeVoidAsync("downloadFileFromBase64", $"فاتورة_{cleanInv}.pdf", "application/pdf", base64);
        }
        catch (Exception ex)
        {
            alertMessage = $"تعذر تحميل ملف الفاتورة: {ex.Message}";
            alertIsError = true;
        }
    }

    private void ExecuteSendWhatsApp()
    {
        if (string.IsNullOrWhiteSpace(whatsAppTargetPhone))
        {
            alertMessage = "يرجى إدخال رقم هاتف واتساب للعميل.";
            alertIsError = true;
            return;
        }

        var ok = WhatsAppInvoiceHelper.OpenWhatsApp(whatsAppTargetPhone, whatsAppMessageText);
        if (ok)
        {
            alertMessage = $"تم فتح محادثة واتساب مع العميل ({targetCustomerForWhatsApp?.Name}) بنجاح.";
            alertIsError = false;
            CloseWhatsAppSenderModal();
        }
        else
        {
            alertMessage = "تعذر فتح تطبيق الواتساب، تأكد من وجود متصفح أو تطبيق واتساب مثبت على الجهاز.";
            alertIsError = true;
        }
    }

    private async Task CopyWhatsAppText()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", whatsAppMessageText);
            isCopied = true;
        }
        catch
        {
            isCopied = false;
        }
    }

    private void CloseWhatsAppSenderModal()
    {
        showWhatsAppSenderModal = false;
        targetCustomerForWhatsApp = null;
        selectedSaleForWhatsApp = null;
        whatsAppMessageText = string.Empty;
        whatsAppSendMode = "pdf";
    }

    // --- Add Customer ---
    private void OpenAddCustomerModal()
    {
        newCustomerName = string.Empty;
        newCustomerPhone = string.Empty;
        newCustomerAddress = null;
        newCustomerEmail = null;
        newCustomerError = null;
        showAddCustomerModal = true;
    }

    private async Task SaveNewCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(newCustomerName))
        {
            newCustomerError = "يرجى إدخال اسم العميل.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newCustomerPhone))
        {
            newCustomerError = "يرجى إدخال رقم هاتف العميل.";
            return;
        }

        isSavingCustomer = true;
        newCustomerError = null;

        var req = new CreateCustomerRequest(newCustomerName.Trim(), newCustomerPhone.Trim(), newCustomerEmail?.Trim(), newCustomerAddress?.Trim());
        var (id, err) = await ApiClient.CreateCustomerAsync(req);
        isSavingCustomer = false;

        if (id.HasValue)
        {
            showAddCustomerModal = false;
            alertMessage = $"تمت إضافة العميل ({newCustomerName}) بنجاح.";
            alertIsError = false;
            await LoadDataAsync();
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncCustomersOnlyAsync());
        }
        else
        {
            newCustomerError = err ?? "فشل حفظ بيانات العميل.";
        }
    }

    // --- Debt Operations ---
    private void OpenQuickPayDebt(CustomerDto cust)
    {
        var debt = allDebts.FirstOrDefault(d => d.CustomerId == cust.Id && d.RemainingAmount > 0);
        if (debt != null)
        {
            OpenPaySpecificDebtModal(debt);
        }
        else
        {
            alertMessage = "لا توجد فواتير دين مفتوحة حالياً لهذا العميل.";
            alertIsError = true;
        }
    }

    private void OpenPaySpecificDebtModal(CustomerDebtDto debt)
    {
        selectedDebtToPay = debt;
        debtPayAmount = debt.RemainingAmount;
        debtPayError = null;
    }

    private async Task SubmitDebtPaymentAsync()
    {
        if (selectedDebtToPay == null || debtPayAmount <= 0) return;
        if (debtPayAmount > selectedDebtToPay.RemainingAmount + 0.01m)
        {
            debtPayError = "المبلغ المحصل أكبر من المتبقي على الفاتورة.";
            return;
        }

        isPayingDebt = true;
        debtPayError = null;

        var (success, err) = await ApiClient.PayCustomerDebtAsync(selectedDebtToPay.SaleId, debtPayAmount);
        isPayingDebt = false;

        if (success)
        {
            alertMessage = $"تم تحصيل مبلغ {debtPayAmount:N2} ج.م من العميل ({selectedDebtToPay.CustomerName}) بنجاح.";
            alertIsError = false;
            selectedDebtToPay = null;

            await LoadDataAsync();
            if (selectedCustomerForDossier != null)
            {
                await OpenCustomerDossier(selectedCustomerForDossier);
            }
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncDebtsAndInstallmentsOnlyAsync());
        }
        else
        {
            debtPayError = err ?? "فشل تسجيل تحصيل الدفعة.";
        }
    }
}
