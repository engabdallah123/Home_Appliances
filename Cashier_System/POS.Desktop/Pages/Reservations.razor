            </div>
            <div class="modal-footer" style="padding: 0.75rem 1.25rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn btn-secondary" style="padding: 0.45rem 1.1rem;" @onclick="ClosePayModal" disabled="@isPaying">
                    إلغاء
                </button>
                <button type="button" class="btn btn-primary" style="padding: 0.45rem 1.3rem; font-weight: 700; background: #6366f1;"
                        @onclick="SubmitReservationPaymentAsync" disabled="@(isPaying || payAmount <= 0)">
                    @if (isPaying)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i>
                        <span>جاري التحصيل والخصم...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i>
                        <span>تأكيد السداد والخصم</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SaleDto> reservations = new();
    private List<SaleDto> filteredReservations = new();

    private int currentPage = 1;
    private int pageSize = 15;
    private IEnumerable<SaleDto> pagedReservations => filteredReservations.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private string searchQuery = string.Empty;
    private int selectedStatusFilter = -1; // -1: All, 1: Reserved, 2: PartiallyDispatched
    private bool isLoading = true;

    private bool showDetailsModal = false;
    private SaleDto? selectedReservation = null;
    private string? statusUpdateFeedback = null;

    // Confirmation Modal State
    private enum ConfirmAction { CompleteDelivery, Cancel }
    private bool showConfirmModal = false;
    private SaleDto? confirmTargetSale = null;
    private ConfirmAction confirmActionType = ConfirmAction.CompleteDelivery;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private string confirmButtonText = string.Empty;
    private bool isConfirmingAction = false;

    // Payment Modal State
    private bool showPayModal = false;
    private SaleDto? payModalSale = null;
    private decimal payAmount = 0m;
    private bool isPaying = false;
    private string? payError = null;

    private static readonly CultureInfo ArabicCulture = new("ar-EG");

    protected override async Task OnInitializedAsync()
    {
        CloudSync.OnDataImported += HandleSyncDataImported;
        await LoadReservations();
    }

    private async void HandleSyncDataImported()
    {
        await InvokeAsync(async () =>
        {
            await LoadReservations(silent: true);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CloudSync.OnDataImported -= HandleSyncDataImported;
    }

    private async Task LoadReservations(bool silent = false)
    {
        if (!silent) isLoading = true;
        try
        {
            var allSales = await ApiClient.GetSalesListAsync() ?? new();
            // Filter only active reservations: neither fully dispatched (3) nor cancelled (0)
            reservations = allSales
                .Where(s => (s.IsReserved || (s.ReservationStatus > 0 && s.ReservationStatus < 3)) && s.ReservationStatus != 3 && s.ReservationStatus != 0)
                .OrderByDescending(s => s.SaleDate)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reservations: {ex.Message}");
        }
        finally
        {
            if (!silent) isLoading = false;
        }
    }

    private void FilterByStatus(int status)
    {
        selectedStatusFilter = status;
        currentPage = 1;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = reservations.AsEnumerable();

        if (selectedStatusFilter == 1)
        {
            query = query.Where(r => r.ReservationStatus == 1 || (r.IsReserved && r.ReservationStatus == 0));
        }
        else if (selectedStatusFilter == 2)
        {
            query = query.Where(r => r.ReservationStatus == 2);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim();
            query = query.Where(r =>
                r.InvoiceNumber.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(r.CustomerName) && r.CustomerName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(r.RecipientPhone) && r.RecipientPhone.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(r.DeliveryAddress) && r.DeliveryAddress.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        filteredReservations = query.ToList();
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        var maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredReservations.Count / pageSize));
        if (currentPage > maxPage)
        {
            currentPage = maxPage;
        }
    }

    private void PromptCompleteDelivery(SaleDto sale)
    {
        confirmTargetSale = sale;
        confirmActionType = ConfirmAction.CompleteDelivery;
        confirmTitle = "تأكيد إتمام التسليم بالكامل";
        confirmMessage = "هل أنت متأكد من تسليم كامل الأجهزة المحجوزة للعميل؟ سيتم إغلاق الحجز وتسليمه بالكامل وحذفه من قائمة الحجوزات النشطة نهائياً.";
        confirmButtonText = "تأكيد إتمام التسليم";
        showConfirmModal = true;
    }

    private void PromptCancelReservation(SaleDto sale)
    {
        confirmTargetSale = sale;
        confirmActionType = ConfirmAction.Cancel;
        confirmTitle = "تأكيد إلغاء الحجز";
        confirmMessage = "هل أنت متأكد من إلغاء هذا الحجز؟ سيتم إلغاء حالة الحجز وحذفه من قائمة الحجوزات النشطة نهائياً.";
        confirmButtonText = "تأكيد إلغاء الحجز";
        showConfirmModal = true;
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        confirmTargetSale = null;
        isConfirmingAction = false;
    }

    private async Task ExecuteConfirmedActionAsync()
    {
        if (confirmTargetSale == null) return;
        isConfirmingAction = true;
        try
        {
            int targetStatus = confirmActionType == ConfirmAction.CompleteDelivery ? 3 : 0;
            await UpdateStatus(confirmTargetSale.Id, targetStatus, closeModal: true);
            CloseConfirmModal();
        }
        finally
        {
            isConfirmingAction = false;
        }
    }

    private void OpenPayModal(SaleDto sale)
    {
        payModalSale = sale;
        payAmount = Math.Max(0, sale.TotalAmount - sale.PaidAmount);
        payError = null;
        showPayModal = true;
    }

    private void ClosePayModal()
    {
        showPayModal = false;
        payModalSale = null;
        payAmount = 0m;
        payError = null;
        isPaying = false;
    }

    private async Task SubmitReservationPaymentAsync()
    {
        if (payModalSale == null || payAmount <= 0) return;
        var remaining = Math.Max(0, payModalSale.TotalAmount - payModalSale.PaidAmount);
        if (payAmount > remaining + 0.01m)
        {
            payError = "المبلغ المحصل أكبر من المبلغ المتبقي على الفاتورة.";
            return;
        }

        isPaying = true;
        payError = null;
        try
        {
            var (success, err) = await ApiClient.PayCustomerDebtAsync(payModalSale.Id, payAmount);
            if (success)
            {
                statusUpdateFeedback = $"تم تسجيل تحصيل مبلغ {payAmount:N2} ج.م من العميل ({payModalSale.CustomerName ?? "عميل نقدي"}) وخصمه من المديونية فوراً بنجاح.";
                ClosePayModal();
                if (showDetailsModal && selectedReservation != null)
                {
                    try
                    {
                        var updated = await ApiClient.GetSaleByIdAsync(selectedReservation.Id);
                        if (updated != null)
                        {
                            selectedReservation = updated;
                        }
                    }
                    catch { }
                }
                await LoadReservations(silent: true);
                try
                {
                    CloudSync.RecordLocalChange();
                    _ = Task.Run(async () => await CloudSync.SyncNowAsync(forceCatalogPush: true));
                }
                catch { }
            }
            else
            {
                payError = err ?? "فشل تسجيل تحصيل الدفعة.";
            }
        }
        catch (Exception ex)
        {
            payError = $"خطأ: {ex.Message}";
        }
        finally
        {
            isPaying = false;
        }
    }

    private async Task UpdateStatus(Guid saleId, int newStatus, bool closeModal = false)
    {
        try
        {
            var (success, error) = await ApiClient.UpdateReservationStatusAsync(saleId, newStatus);
            if (success)
            {
                statusUpdateFeedback = newStatus switch
                {
                    3 => "تم تأكيد تسليم كامل الأجهزة المحجوزة وإغلاق الحجز وحذفه من قائمة الحجوزات بنجاح.",
                    2 => "تم تسجيل تسليم جزئي للأجهزة بنجاح.",
                    0 => "تم إلغاء الحجز وحذفه من قائمة الحجوزات بنجاح.",
                    _ => "تم تحديث حالة الحجز بنجاح."
                };

                if (closeModal)
                {
                    showDetailsModal = false;
                }

                await LoadReservations(silent: true);
                try
                {
                    CloudSync.RecordLocalChange();
                    _ = Task.Run(async () => await CloudSync.SyncNowAsync());
                }
                catch { }
            }
            else
            {
                statusUpdateFeedback = $"فشل تحديث الحالة: {error}";
            }
        }
        catch (Exception ex)
        {
            statusUpdateFeedback = $"خطأ: {ex.Message}";
        }
    }

    private async Task OpenDetailsModal(SaleDto res)
    {
        selectedReservation = res;
        showDetailsModal = true;
        if (res.Items == null || !res.Items.Any())
        {
            try
            {
                var detail = await ApiClient.GetSaleByIdAsync(res.Id);
                if (detail != null && detail.Items != null && detail.Items.Any())
                {
                    selectedReservation = detail;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching reservation details: {ex.Message}");
            }
        }
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedReservation = null;
    }

    private async Task PrintPdf(Guid saleId)
    {
        try
        {
            await Printer.PrintInvoiceAsync(saleId, isThermal: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing voucher: {ex.Message}");
        }
    }
}
